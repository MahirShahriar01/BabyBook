# --- Supabase backend (recommended for production) ------------------------
# Without these the Admin Panel runs in DEMO MODE: edits are saved in this
# browser and you can export a content.json for static hosting.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Optional: link shown in the sidebar to open the kids web app
VITE_WEB_APP_URL=http://localhost:5173
