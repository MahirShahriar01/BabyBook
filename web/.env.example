# --- Optional: connect to the Admin Panel's Supabase backend ---------------
# Without these the website runs fully offline using the bundled seed content.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Optional: static content bundle (JSON exported from the Admin Panel) ---
# Used when Supabase is not configured. Can be any public URL or a file in /public.
# VITE_CONTENT_URL=./content.json

# --- Optional: Talking Buddy cloud AI (Supabase Edge Function "buddy") -----
# Leave empty to use the free on-device correction engine.
# VITE_BUDDY_AI_URL=https://YOUR-PROJECT.functions.supabase.co/buddy
